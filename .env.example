# ==============================================================================
# MenzaOrder - Environment Configuration Template (.env.example)
# ==============================================================================
# Copy this file to '.env' or '.env.local' and customize values for your environment.
# DO NOT COMMIT SENSITIVE SECRETS OR CREDENTIALS TO SOURCE CONTROL.
# ==============================================================================

# Backend REST API Service Endpoint (e.g. Azure App Service or local dev server)
VITE_API_BASE_URL=https://your-api-domain.azurewebsites.net

# SignalR Real-Time WebSocket Hub (Optional: defaults to ${VITE_API_BASE_URL}/hubs/order)
VITE_SIGNALR_HUB_URL=https://your-api-domain.azurewebsites.net/hubs/order

# Azure Blob Storage Base CDN URL for Restaurant & Dish Images
VITE_AZURE_BLOB_BASE_URL=https://your-storage-account.blob.core.windows.net/container/

# Security Salt Seed used for Obfuscating Internal Restaurant IDs
VITE_ENCRYPTION_SALT=YourSecretSaltPhrase

# Cashfree Payment Gateway Mode ('production' or 'sandbox')
VITE_CASHFREE_MODE=sandbox

# Axios API Request Timeout in Milliseconds
VITE_API_TIMEOUT_MS=7000

# Public Storefront / Table QR Base Host URL (Optional, defaults to window.location.origin)
VITE_APP_URL=

# Default Fallback Images (Unsplash CDN or local assets)
VITE_DEFAULT_VEG_IMAGE=https://images.unsplash.com/photo-1540420773420-3366772f4999?w=600
VITE_DEFAULT_NON_VEG_IMAGE=https://images.unsplash.com/photo-1544025162-d76694265947?w=600

# Application Branding & Display Name
VITE_APP_NAME=MenzaOrder
